{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=asms_db;Username=<db_user>;Password=<db_password>"
  },
  "Jwt": {
    "Key": "<your-secret-key-minimum-32-characters-long>",
    "Issuer": "ASMS",
    "Audience": "ASMS",
    "ExpiryHours": 24
  }
}
